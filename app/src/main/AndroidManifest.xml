<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Lumen declares NO permissions. Book import goes through the Storage Access
      Framework (no storage permission needed), the dictionary ships in the APK
      (no INTERNET needed), and the web-lookup escape hatch is an ACTION_VIEW
      intent handed to the browser (no INTERNET needed). See README "Privacy".

      The two removals below are not Lumen's: Readium's navigator depends on Media3 /
      ExoPlayer for audiobook playback, and ExoPlayer's own manifest asks for these.
      Lumen never plays audio, so the code that would use them never runs. Stripping
      them here keeps the installed permission list at exactly zero — which is the
      claim the README makes, so it has to be literally true, not true-except-for.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.WAKE_LOCK"
        tools:node="remove" />

    <!--
      M11 read-aloud. These three exist for exactly one purpose: letting the voice keep
      going with the screen off, and giving you lock-screen play/pause. Android does not
      allow background audio without a foreground service, and from Android 13 a
      foreground service must be able to post its notification.

      None of them grants access to files, the network, the microphone or anything about
      you. Lumen still declares no INTERNET permission, so read-aloud is local speech
      synthesis and nothing leaves the phone. See README "Privacy".
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      1.4.0: "Find books on this phone" searches all of shared storage. Android offers no
      permission scoped to one file type — MANAGE_EXTERNAL_STORAGE is the only thing that
      can see files the user has not handed over a folder at a time, and it is broad.
      The owner asked for the thorough search after using the folder-by-folder version.

      Lumen only reads, and only looks for .epub. Nothing is written, moved or deleted,
      and with no INTERNET permission nothing it finds can leave the phone. It is
      requested when you first use the search, never at launch, and the app still works
      without it — the folder picker remains.

      Google Play forbids this permission for apps like this one. That does not apply
      here (Lumen is sideloaded and never published), and `tools:ignore` records that the
      lint warning was read rather than missed.
    -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <!-- Android 10 and below have no all-files concept; this is the equivalent there. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:name=".LumenApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lumen.Starting">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale"
            android:resizeableActivity="true"
            android:theme="@style/Theme.Lumen.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Read-aloud's background playback (M11). Not exported: nothing outside Lumen
             may start it. -->
        <service
            android:name=".feature.speech.SpeechService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
