<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing leaves the device. Cloud backup and device-to-device transfer are both
  refused outright; the user's safety net is the explicit backup/restore file
  built in M6, which they control.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
