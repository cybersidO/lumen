<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 counterpart of data_extraction_rules.xml. Backup is already off via
  android:allowBackup="false"; this exists so the intent is explicit on every API level
  Lumen supports.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
