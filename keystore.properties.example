# Copy to `keystore.properties` (which is gitignored — check with `git check-ignore -v
# keystore.properties` before you fill it in). Paths are relative to the repo root.
#
# The same four values can instead be exported as environment variables:
#   LUMEN_KEYSTORE_FILE, LUMEN_KEYSTORE_PASSWORD, LUMEN_KEY_ALIAS, LUMEN_KEY_PASSWORD
# The properties file wins when both are present.

storeFile=lumen-release.jks
storePassword=
keyAlias=lumen
keyPassword=
